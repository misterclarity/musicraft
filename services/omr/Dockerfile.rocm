# Musicraft recognition service, AMD ROCm build (e.g. Radeon Pro W7800).
#   docker build -f Dockerfile.rocm -t musicraft-omr:rocm services/omr
# Run with --device=/dev/kfd --device=/dev/dri --group-add video --group-add render
# (deploy/docker-compose.rocm.yml does this). Based on homr's own Dockerfile.rocm.
FROM rocm/dev-ubuntu-24.04:7.0

# Which homr to install (a pip requirement): by default a pinned commit of its main branch.
ARG HOMR_SPEC="homr[rocm] @ git+https://github.com/liebharc/homr@33dd138b0a79a6e513bf2b2e31caddde12c01063"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LD_LIBRARY_PATH=/opt/rocm/lib

# The onnxruntime-rocm wheel links against these ROCm libraries.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip git libgl1 libglib2.0-0 \
      miopen-hip hipfft rccl rocsolver rocblas \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
# Ubuntu's pip gives up on a download after 15 s without data and cannot resume it;
# this build fetches several hundred MB, so a single network stall used to fail it.
ENV PIP_DEFAULT_TIMEOUT=60

# The ROCm extra pulls onnxruntime-rocm for Python 3.12 (Ubuntu 24.04's Python).
# homr's own downloader times out after 5 s; fetch the models patiently first, then let
# `homr --init` verify that everything is in place.
COPY scripts/fetch_homr_models.py /tmp/fetch_homr_models.py
RUN pip install "${HOMR_SPEC}" \
 && python /tmp/fetch_homr_models.py --gpu \
 && homr --init

# A second homr, the PyPI release, in its own environment and on the CPU. Versions read some pages
# differently, so the app can have every page read by both and keep the better reading (Settings
# shows whether it's there). Build with --build-arg HOMR_SECOND_SPEC= to leave it out: the image
# is then about 450 MB smaller.
ARG HOMR_SECOND_SPEC="homr==0.7.0"
RUN if [ -n "${HOMR_SECOND_SPEC}" ]; then \
      python3 -m venv /opt/homr-second \
      && /opt/homr-second/bin/pip install "${HOMR_SECOND_SPEC}" \
      && /opt/homr-second/bin/python /tmp/fetch_homr_models.py \
      && /opt/homr-second/bin/homr --init; \
    fi \
 && rm /tmp/fetch_homr_models.py
ENV MUSICRAFT_OMR_SECOND_HOMR_COMMAND=/opt/homr-second/bin/homr

# onnxruntime-rocm's SkipLayerNormalization kernel rejects the broadcast input homr's decoder
# uses, so every page failed on the GPU; rewrite those nodes as Add + LayerNormalization.
COPY scripts/unfuse_skipln.py /tmp/unfuse_skipln.py
RUN pip install onnx \
 && python /tmp/unfuse_skipln.py "$(python -c 'import homr, os; print(os.path.dirname(homr.__file__))')"/transformer/decoder_*.onnx \
 && rm /tmp/unfuse_skipln.py

WORKDIR /app
COPY pyproject.toml README.md ./
COPY musicraft_omr ./musicraft_omr
RUN pip install .

RUN mkdir -p /tmp/musicraft-omr

ENV MUSICRAFT_OMR_HOST=0.0.0.0 \
    MUSICRAFT_OMR_PORT=8070
EXPOSE 8070
CMD ["musicraft-omr"]
